<?xml version="1.0" encoding="utf-8"?>
<!-- Градиентный принтер вместо bitmap: не требует плотностей и работает на всех API -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="112dp" android:height="112dp" />
            <solid android:color="@color/paper" />
            <stroke android:width="2dp" android:color="@color/ink" />
        </shape>
    </item>
</layer-list>
